{
  "schema_version": 1,
  "_notes": {
    "purpose": "Shared deterministic vectors for herdr-mcp Relay/link Batch 5: pure lifecycle/policy parity for the workstation-side herdr-link client. Covers (1) ConnectionPhase set/order/representative high-level transitions, (2) hello_ack refusal classification, (3) socket-close policy, (4) reconnect-cap vectors, and (5) heartbeat/silence pure vectors.",
    "oracle_convention": "`oracle: node_parity` means the case is directly executable against the existing TypeScript/Node implementation (src/link/client.ts) and must match it exactly. All cases here are node_parity.",
    "fatal_convention": "`fatal` is the boolean the client uses to decide reconnect vs stop. For hello_ack refusals it is `classifyFatalCode(code) !== \"fatal_error\"`; handshake_timeout is emitted directly with fatal:false. `reconnect` is the inverse of fatal for these vectors.",
    "no_secrets": "All tokens/endpoints are synthetic test values; no real credentials."
  },
  "connection_phases": {
    "set": ["idle", "connecting", "handshake", "online", "reconnecting", "closing", "closed"],
    "order": ["idle", "connecting", "handshake", "online", "reconnecting", "closing", "closed"],
    "transitions": [
      { "from": "idle", "to": "connecting", "via": "start() begins the run loop" },
      { "from": "connecting", "to": "handshake", "via": "socket open event" },
      { "from": "handshake", "to": "online", "via": "hello_ack ok:true" },
      { "from": "online", "to": "reconnecting", "via": "socket dropped (non-fatal close)" },
      { "from": "reconnecting", "to": "connecting", "via": "backoff delay elapses, next attempt" },
      { "from": "reconnecting", "to": "closing", "via": "close() during backoff wait" },
      { "from": "online", "to": "closing", "via": "graceful close()" },
      { "from": "closing", "to": "closed", "via": "socket closed after drain" },
      { "from": "handshake", "to": "closed", "via": "fatal hello_ack refusal (auth/contract)" },
      { "from": "connecting", "to": "reconnecting", "via": "socket closes before open (retryable drop)" },
      { "from": "online", "to": "closed", "via": "fatal close (superseded/auth)" }
    ]
  },
  "hello_ack_classification": [
    {
      "name": "auth_rejected is fatal auth_rejected, no reconnect",
      "oracle": "node_parity",
      "code": "auth_rejected",
      "classify": "auth_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "auth_expired is fatal auth_rejected, no reconnect",
      "oracle": "node_parity",
      "code": "auth_expired",
      "classify": "auth_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "session_invalid is fatal auth_rejected, no reconnect",
      "oracle": "node_parity",
      "code": "session_invalid",
      "classify": "auth_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "contract_mismatch is fatal contract_rejected, no reconnect",
      "oracle": "node_parity",
      "code": "contract_mismatch",
      "classify": "contract_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "contract_rejected is fatal contract_rejected, no reconnect",
      "oracle": "node_parity",
      "code": "contract_rejected",
      "classify": "contract_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "protocol_incompatible is fatal contract_rejected, no reconnect",
      "oracle": "node_parity",
      "code": "protocol_incompatible",
      "classify": "contract_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "internal_error classifies fatal_error but is treated non-fatal (retryable drop)",
      "oracle": "node_parity",
      "code": "internal_error",
      "classify": "fatal_error",
      "fatal": false,
      "reconnect": true
    },
    {
      "name": "unknown code classifies fatal_error but is treated non-fatal (retryable drop)",
      "oracle": "node_parity",
      "code": "edge_hiccup",
      "classify": "fatal_error",
      "fatal": false,
      "reconnect": true
    },
    {
      "name": "handshake_timeout is retryable (emitted fatal:false directly)",
      "oracle": "node_parity",
      "code": "handshake_timeout",
      "classify": "fatal_error",
      "fatal": false,
      "reconnect": true
    }
  ],
  "socket_close_policy": [
    {
      "name": "4409 superseded is fatal, no reconnect",
      "oracle": "node_parity",
      "code": 4409,
      "exit_kind": "superseded",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "1008 auth_rejected is fatal, no reconnect",
      "oracle": "node_parity",
      "code": 1008,
      "exit_kind": "auth_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "4401 auth_rejected is fatal, no reconnect",
      "oracle": "node_parity",
      "code": 4401,
      "exit_kind": "auth_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
      "name": "4403 auth_rejected is fatal, no reconnect",
      "oracle": "node_parity",
      "code": 4403,
      "exit_kind": "auth_rejected",
      "fatal": true,
      "reconnect": false
    },
    {
