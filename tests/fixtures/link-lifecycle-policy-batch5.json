    }
  ],
  "reconnect_cap": [
    {
      "name": "null maxReconnectAttempts is unlimited",
      "oracle": "node_parity",
      "maxReconnectAttempts": null,
      "expected_exit": null,
      "observe_attempts": 3,
      "note": "loop retries indefinitely; observe three reconnect attempts, then stop the test harness explicitly"
    },
    {
      "name": "max=0 means no retry (max_reconnect after first attempt)",
      "oracle": "node_parity",
      "maxReconnectAttempts": 0,
      "expected_exit": "max_reconnect",
      "factory_calls": 1,
      "note": "plannedAttempt=1 > 0 stops the loop before any retry"
    },
    {
      "name": "max=1 allows exactly one retry",
      "oracle": "node_parity",
      "maxReconnectAttempts": 1,
      "expected_exit": "max_reconnect",
      "factory_calls": 2,
      "note": "attempt 1 allowed; attempt 2 > 1 stops the loop"
    },
    {
      "name": "attempt value after backoff.next()",
      "oracle": "node_parity",
      "maxReconnectAttempts": 3,
      "expected_exit": "max_reconnect",
      "factory_calls": 4,
      "note": "attempts 1,2,3 allowed; attempt 4 > 3 stops; reconnect_attempt equals backoff.attempt"
    }
  ],
  "heartbeat_silence": {
    "heartbeat_gate": {
      "note": "heartbeatTick sends only when phase=online AND not stopped AND socket open",
      "conditions": [
        { "phase": "online", "stopped": false, "socket_open": true, "should_heartbeat": true },
        { "phase": "reconnecting", "stopped": false, "socket_open": true, "should_heartbeat": false },
        { "phase": "handshake", "stopped": false, "socket_open": true, "should_heartbeat": false },
        { "phase": "online", "stopped": true, "socket_open": true, "should_heartbeat": false },
        { "phase": "online", "stopped": false, "socket_open": false, "should_heartbeat": false }
      ]
    },
    "silence_interval": [
      { "name": "heartbeatMs dominates when small", "heartbeatMs": 1000, "maxSilenceMs": 90000, "expected": 1000 },
      { "name": "maxSilenceMs/3 dominates when smaller", "heartbeatMs": 30000, "maxSilenceMs": 90000, "expected": 30000 },
      { "name": "maxSilenceMs/3 floor when heartbeat large", "heartbeatMs": 300000, "maxSilenceMs": 90000, "expected": 30000 },
      { "name": "250ms floor when both tiny", "heartbeatMs": 100, "maxSilenceMs": 300, "expected": 250 },
      { "name": "250ms floor when maxSilenceMs/3 below floor", "heartbeatMs": 1000, "maxSilenceMs": 300, "expected": 250 }
    ],
    "silence_expiry": [
      { "name": "not expired within maxSilenceMs", "lastEdgeSeenMs": 1000, "connectedAtMs": 500, "now": 1000, "maxSilenceMs": 90000, "expired": false },
      { "name": "not expired exactly at maxSilenceMs boundary (strict >)", "lastEdgeSeenMs": 1000, "connectedAtMs": 500, "now": 91000, "maxSilenceMs": 90000, "expired": false },
      { "name": "expired just past maxSilenceMs", "lastEdgeSeenMs": 1000, "connectedAtMs": 500, "now": 91001, "maxSilenceMs": 90000, "expired": true },
      { "name": "base falls back to connectedAtMs when lastEdgeSeenMs null", "lastEdgeSeenMs": null, "connectedAtMs": 5000, "now": 95001, "maxSilenceMs": 90000, "expired": true },
      { "name": "base falls back to 0 when both null", "lastEdgeSeenMs": null, "connectedAtMs": null, "now": 90001, "maxSilenceMs": 90000, "expired": true }
    ]
  }
}
