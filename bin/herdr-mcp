#!/usr/bin/env bash
# herdr-mcp CLI — manage the herdr MCP server (launchd + config + diagnostics)
# Install: ln -sf ~/Documents/herdr-mcp/bin/herdr-mcp ~/.local/bin/herdr-mcp
#
# Usage:
#   herdr-mcp                    # Interactive menu
#   herdr-mcp status             # Process, launchd, local/public endpoint, and socket status
#   herdr-mcp connector          # Print connection details (URL and token)
#   herdr-mcp watchdog [once|status|install|uninstall]
#   herdr-mcp start|stop|restart # Manage the launchd service
#   herdr-mcp logs [-f]          # View logs
#   herdr-mcp token              # Copy token to clipboard
#   herdr-mcp url                # Copy public URL

set -euo pipefail

ROOT="$(python3 -c "import os,sys; print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))" "${BASH_SOURCE[0]}")"
# shellcheck source=lib/i18n.sh
source "$ROOT/bin/lib/i18n.sh"

PLIST="$HOME/Library/LaunchAgents/dev.herdr-mcp.server.plist"
LABEL="dev.herdr-mcp.server"
LOG_FILE="$HOME/.config/herdr-mcp/server.log"
LOCAL_URL="http://127.0.0.1:8772/mcp"

# Colors
R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'; B=$'\033[1m'; N=$'\033[0m'

log()  { echo -e "  ${G}✅${N} $*"; }
warn() { echo -e "  ${Y}⚠️${N} $*"; }
err()  { echo -e "  ${R}❌${N} $*" >&2; }

# ---- Read configuration from plist ----
get_plist_value() {
  /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$1" "$PLIST" 2>/dev/null || echo ""
}

get_token()   { get_plist_value "HERDR_MCP_TOKEN"; }
get_port()    { get_plist_value "HERDR_MCP_PORT" || echo "8772"; }
get_base_url(){ get_plist_value "HERDR_MCP_BASE_URL"; }

get_public_url() {
  local base
  base=$(get_base_url)
  if [[ -n "$base" ]]; then
    echo "${base%/}/mcp"
  else
    # No hardcoded personal domain — README recommends the user's own workers.dev Edge.
    echo ""
  fi
}

# ---- Service status ----
is_running() {
  pgrep -f "dist/server.js" >/dev/null 2>&1
}

service_pid() {
  pgrep -f "dist/server.js" 2>/dev/null | head -1 || echo ""
}

# ---- Local MCP health check ----
check_local() {
  local token code
  token=$(get_token)
  if ! code=$(curl -s -o /dev/null -w "%{http_code}" -m 3 \
    -X POST "$LOCAL_URL" \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -d '{"jsonrpc":"2.0","id":1,"method":"server/discover","params":{}}' \
    2>/dev/null); then
    code="000"
  fi
  [[ "$code" =~ ^[0-9]{3}$ ]] || code="000"
  echo "$code"
}

check_public() {
  local token pub_url code
  token=$(get_token)
  pub_url=$(get_public_url)
  if [[ -z "$pub_url" ]]; then
    echo "unset"
    return 0
  fi
  code=$(curl -s -o /dev/null -w "%{http_code}" -m 5 \
    -X POST "$pub_url" \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"cli-check","version":"0"}}}' \
    2>/dev/null || echo "000")
  echo "$code"
}

# ---- Commands ----

cmd_status() {
  echo ""
  echo -e "${B}${C}═══════════════════════════════════════════════════════════${N}"
  echo -e "${B}${C}  $(T status_title)${N}"
  echo -e "${B}${C}═══════════════════════════════════════════════════════════${N}"
  echo ""

  if is_running; then
    local pid
    pid=$(service_pid)
    log "$(T proc_running) (PID $pid)"
  else
    err "$(T proc_stopped)"
  fi

  if launchctl list 2>/dev/null | python3 -c "
import sys
found = any('dev.herdr-mcp' in l for l in sys.stdin)
sys.exit(0 if found else 1)
"; then
    log "$(T launchd_loaded)"
  else
    warn "$(T launchd_missing)"
  fi
  local lcode
  lcode=$(check_local)
  if [[ "$lcode" == "200" ]]; then
    log "$(T local_ok) ($LOCAL_URL)"
  elif [[ "$lcode" == "401" ]]; then
    warn "$(T local_401)"
  elif [[ "$lcode" == "000" ]]; then
    err "$(T local_down)"
  else
    err "$(T local_http) $lcode"
  fi

  local pcode pub_url
  pcode=$(check_public)
  pub_url=$(get_public_url)
  if [[ "$pcode" == "unset" ]]; then
    warn "$(T public_unset)"
  elif [[ "$pcode" == "200" ]]; then
    log "$(T public_ok) ($pub_url)"
  elif [[ "$pcode" == "000" ]]; then
    warn "$(T public_down)"
  else
    warn "$(T public_http) $pcode"
  fi

  local sock
  sock="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
  if [[ -S "$sock" ]]; then
    log "$(T sock_ok) ($sock)"
  else
    err "$(T sock_missing) ($sock)"
  fi

  echo ""
}

cmd_connector() {
  local token base pub
  token=$(get_token)
  base=$(get_base_url); base="${base%/}"
  pub=$(get_public_url)
  echo ""
  echo -e "${B}${C}═══════════════════════════════════════════════════════════${N}"
  echo -e "${B}${C}  $(T connector_title)${N}"
  echo -e "${B}${C}═══════════════════════════════════════════════════════════${N}"
  echo ""
  if [[ -n "$pub" ]]; then
    echo "  ChatGPT : $pub              (OAuth)"
    echo "  Claude  : $pub              (OAuth / DCR)"
  else
    echo "  $(T public_unset_line)"
    echo "  $(T recommend_edge)"
    echo "            → https://<worker>.<account>.workers.dev/mcp"
    echo "            set HERDR_MCP_BASE_URL to the Worker origin; Custom Domain is optional"
  fi
  echo "  Local   : $LOCAL_URL"
  echo "  Token   : $token"
  echo ""
  echo "  $(T config_docs)"
  echo ""
}

cmd_start() {
  if is_running; then
    log "$(T already_running) (PID $(service_pid))"
    return 0
  fi
  launchctl load "$PLIST" 2>&1
  sleep 2
  if is_running; then
    log "$(T started) (PID $(service_pid))"
  else
    err "$(T start_failed)"
  fi
}

cmd_stop() {
  launchctl unload "$PLIST" 2>&1 || true
  sleep 1
  if is_running; then
    pkill -f "dist/server.js" 2>/dev/null || true
    sleep 1
  fi
  if is_running; then
    err "$(T stop_failed)"
  else
    log "$(T stopped)"
  fi
}

cmd_restart() {
  pkill -f "dist/server.js" 2>/dev/null || true
  sleep 1
  if ! is_running; then
    launchctl load "$PLIST" 2>/dev/null || true
    sleep 3
  fi
  if is_running; then
    log "$(T restarted) (PID $(service_pid))"
  else
    err "$(T restart_failed)"
  fi
}

cmd_logs() {
  local follow="${1:-}"
  if [[ ! -f "$LOG_FILE" ]]; then
    warn "$(T no_log) $LOG_FILE"
    return 0
  fi
  if [[ "$follow" == "-f" ]]; then
    tail -f "$LOG_FILE"
  else
    tail -50 "$LOG_FILE"
  fi
}

cmd_token() {
  local token
  token=$(get_token)
  if [[ -z "$token" ]]; then
    err "$(T no_token)"
    return 1
  fi
  echo -n "$token" | pbcopy 2>/dev/null && echo "$(T copied)" || true
  echo "Token: $token"
}

cmd_url() {
  local pub_url
  pub_url=$(get_public_url)
  if [[ -z "$pub_url" ]]; then
    err "$(T no_base_url)"
    return 1
  fi
  echo -n "$pub_url" | pbcopy 2>/dev/null && echo "$(T copied)" || true
  echo "URL: $pub_url"
}

cmd_lang() {
  local code="${1:-}"
  if [[ -z "$code" ]]; then
    echo "$(T lang_now) $HERDR_MCP_LANG ($HERDR_MCP_UI_CFG)"
    return 0
  fi
  herdr_mcp_set_lang "$code"
}

cmd_watchdog() {
  local sub="${1:-once}"
  exec "$ROOT/bin/watchdog.sh" "$sub"
}

# ---- interactive menu ----
cmd_menu() {
  cmd_status
  cmd_connector

  while true; do
    echo ""
    echo -e "${B}${C}═══════════════════════════════════════════════════════════${N}"
    echo -e "${B}${C}  $(T menu_title)${N}"
    echo -e "${B}${C}═══════════════════════════════════════════════════════════${N}"
    echo ""
    echo "$(T menu_prompt)"
    T menu_1; T menu_2; T menu_3; T menu_4; T menu_5; T menu_6; T menu_7; T menu_8; T menu_9
    echo ""
    if ! read -n 1 -s -r -p "  > " choice 2>/dev/null; then
      echo ""
      exit 0
    fi
    echo ""
    case "$choice" in
      1) cmd_status ;;
      2) cmd_connector ;;
      3) cmd_restart ;;
      4) cmd_start ;;
      5) cmd_stop ;;
      6) cmd_logs ;;
      7) cmd_token ;;
      8) cmd_url ;;
      9)
        echo "  en / zh / ja"
        if read -r -p "  lang> " newlang 2>/dev/null; then
          herdr_mcp_set_lang "$newlang" || true
        fi
        ;;
      q|Q|quit|exit) exit 0 ;;
      *) exit 0 ;;
    esac
  done
}

# ---- entry ----
case "${1:-}" in
  status)   cmd_status ;;
  connector) cmd_connector ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_restart ;;
  logs)     cmd_logs "${2:-}" ;;
  token)    cmd_token ;;
  url)      cmd_url ;;
  lang)     cmd_lang "${2:-}" ;;
  watchdog) cmd_watchdog "${2:-once}" ;;
  ""|menu)  cmd_menu ;;
  -h|--help)
    echo "$(T help_usage)"
    echo ""
    echo "$(T help_cmds)"
    echo "$(T help_menu)"
    echo "$(T help_status)"
    echo "$(T help_connector)"
    echo "$(T help_start)"
    echo "$(T help_stop)"
    echo "$(T help_restart)"
    echo "$(T help_logs)"
    echo "$(T help_token)"
    echo "$(T help_url)"
    echo "$(T help_lang)"
    echo "$(T help_watchdog)"
    ;;
  *)
    err "$(T unknown_cmd) $1 (herdr-mcp --help)"
    exit 1
    ;;
esac
