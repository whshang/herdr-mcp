#!/usr/bin/env node
/**
 * Compatibility entrypoint only.
 *
 * Native Messaging ownership lives in the Rust herdr-mcp binary. This wrapper
 * deliberately contains no extension-id derivation, manifest mutation, token
 * broker, or local-extension install logic.
 */
import { constants as fsConstants } from "node:fs";
import { access } from "node:fs/promises";
import { homedir } from "node:os";
import { join } from "node:path";
import { spawnSync } from "node:child_process";

async function existingExecutable(path) {
  try {
    await access(path, fsConstants.X_OK);
    return path;
  } catch {
    return null;
  }
}

async function resolveHerdrMcp() {
  const explicit = String(process.env.HERDR_MCP_BIN || "").trim();
  if (explicit) return explicit;

  for (const candidate of [
    join(homedir(), ".config", "herdr-mcp", "runtime", "current", "herdr-mcp"),
    join(homedir(), ".local", "bin", "herdr-mcp"),
  ]) {
    const found = await existingExecutable(candidate);
    if (found) return found;
  }
  return "herdr-mcp";
}

const args = process.argv.slice(2);
const runAsHost = args.length === 0 || String(args[0]).startsWith("chrome-extension://");
const childArgs = runAsHost ? ["extension-host", ...args] : ["native-host", ...args];
const binary = await resolveHerdrMcp();
const result = spawnSync(binary, childArgs, {
  env: process.env,
  stdio: "inherit",
});

if (result.error) {
  console.error(`herdr-extension-host: failed to delegate to ${binary}: ${result.error.message}`);
  process.exit(1);
}
if (result.signal) {
  console.error(`herdr-extension-host: delegated herdr-mcp terminated by ${result.signal}`);
  process.exit(1);
}
process.exit(result.status ?? 1);
