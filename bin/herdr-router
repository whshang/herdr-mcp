#!/usr/bin/env python3
"""
herdr-mcp path router — one public entry point that routes project MCP servers by path prefix.

URL forms:
  https://herdr-mcp.<domain>/<project>/mcp
  https://herdr-mcp.<domain>/<project>/oauth/...
  https://herdr-mcp.<domain>/<project>/.well-known/...

OAuth (RFC 8414) compatibility:
  OAuth clients such as Claude discover /.well-known/oauth-authorization-server at the origin root.
  With one project, route root-level discovery to that project. With multiple
  projects, root-level discovery is ambiguous and returns 404 with guidance.


Local endpoints:
  GET  /            → status page with projects and health
  GET  /projects    → JSON project list for the browser extension
  *    /<project>/* → strip the prefix and proxy to 127.0.0.1:<port>/*

Route table: $HERDR_MCP_ROUTER_STATE_DIR/routes.json
  {"project": {"port": 8772, "token": "...", "path": "/path/to/project"}, ...}

Environment:
  HERDR_MCP_ROUTER_STATE_DIR  defaults to ~/.config/herdr-mcp/router
  HERDR_MCP_ROUTER_HOST       defaults to 127.0.0.1
  HERDR_MCP_ROUTER_PORT       defaults to 8773, separate from MCP origin 8772
"""
from __future__ import annotations

import json
import os
import socket
import sys
import threading
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Any


# Do not follow redirects: OAuth 302 responses must pass through to the browser,
# which carries its own cookie and session to the callback.
class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_OPENER = urllib.request.build_opener(_NoRedirectHandler)


STATE_DIR = os.path.expanduser(os.environ.get("HERDR_MCP_ROUTER_STATE_DIR", "~/.config/herdr-mcp/router"))
HOST = os.environ.get("HERDR_MCP_ROUTER_HOST", "127.0.0.1")
PORT = int(os.environ.get("HERDR_MCP_ROUTER_PORT", "8773"))
# Optional subdomain-routing suffix. Host=<project><suffix> routes by subdomain
# and forwards paths unchanged for pathless issuer compatibility.
HOST_SUFFIX = os.environ.get("HERDR_MCP_HOST_SUFFIX", "")
ROUTES_FILE = os.path.join(STATE_DIR, "routes.json")
# Headers omitted when forwarding upstream; urllib sets Content-Length.
HOP_BY_HOP = {
    "connection",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailers",
    "transfer-encoding",
    "upgrade",
    "content-length",
    "host",
}
# Response headers omitted downstream, preserving framing-critical Content-Length.
RESPONSE_SKIP = HOP_BY_HOP - {"content-length"}


def load_routes() -> dict[str, dict[str, Any]]:
    try:
        with open(ROUTES_FILE, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except Exception as exc:
        print(f"[herdr-mcp-router] routes load error: {exc}", file=sys.stderr)
        return {}


def rebuild_routes_from_confs() -> dict[str, dict[str, Any]]:
    """Fallback: scan *.conf if routes.json missing."""
    routes: dict[str, dict[str, Any]] = {}
    try:
        for name in os.listdir(STATE_DIR):
            if not name.endswith(".conf"):
                continue
            cfg: dict[str, str] = {}
            with open(os.path.join(STATE_DIR, name), encoding="utf-8") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=", 1)
                        cfg[k] = v
            short = cfg.get("name") or name[: -len(".conf")]
            port = cfg.get("port")
            if not port:
                continue
            routes[short] = {
                "port": int(port),
                "token": cfg.get("token", ""),
                "path": cfg.get("path", ""),
            }
    except FileNotFoundError:
        pass
    return routes


_routes_lock = threading.Lock()
_routes_cache: dict[str, dict[str, Any]] = {}
_routes_mtime = 0.0


def get_routes() -> dict[str, dict[str, Any]]:
    global _routes_cache, _routes_mtime
    with _routes_lock:
        try:
            mtime = os.path.getmtime(ROUTES_FILE)
        except OSError:
            mtime = 0.0
            routes = rebuild_routes_from_confs()
            _routes_cache = routes
            _routes_mtime = mtime
            return routes
        if mtime != _routes_mtime or not _routes_cache:
            _routes_cache = load_routes() or rebuild_routes_from_confs()
            _routes_mtime = mtime
        return _routes_cache


# Root OAuth and well-known discovery paths route to the sole project when unambiguous.
def _root_oauth_path(path: str) -> bool:
    return (
        path.startswith("/.well-known/")
        or path.startswith("/oauth/")
        or path == "/register"
    )


# Claude.ai constructs discovery URLs by inserting the server path:
#   https://herdr-mcp.<d>/novo/mcp → /.well-known/oauth-authorization-server/novo[/mcp]
# Newer clients may append /mcp to serverUrl:
#   https://<proj>.<d>/mcp     → /.well-known/oauth-protected-resource/mcp
# Strip the project segment or /mcp suffix and forward the canonical path.
def _split_discovery_insertion(path: str) -> tuple[str | None, str | None]:
    parts = [p for p in path.split("/") if p]
    routes = get_routes()
    if len(parts) < 3:
        return None, None
    if parts[0] == ".well-known":
        if parts[2] in routes:
            return parts[2], "/.well-known/" + parts[1]
        if parts[2] == "mcp":  # serverUrl suffix: /<kind>/mcp → /<kind>
            return None, "/.well-known/" + parts[1]
    elif parts[0] == "oauth":
        if parts[2] in routes:
            return parts[2], "/oauth/" + parts[1]
    return None, None


def _strip_well_known_mcp_suffix(path: str) -> str:
    """Strip a serverUrl /mcp suffix copied into a well-known discovery path."""
    if not path.startswith("/.well-known/"):
        return path
    if path.endswith("/mcp"):
        stripped = path[: -len("/mcp")]
        if stripped != "/.well-known" and stripped.startswith("/.well-known/"):
            return stripped
    return path


def resolve_route(path: str, host: str = "") -> tuple[str | None, dict[str, Any] | None, str]:
    """Return (project, route, remainder_path). remainder always starts with /.

    Route by subdomain when host matches HERDR_MCP_HOST_SUFFIX, preserving the path.
    """
    # ---- Subdomain routing with a pathless issuer ----
    if HOST_SUFFIX and host:
        h = host.split(":", 1)[0].lower()
        if h.endswith(HOST_SUFFIX):
            prefix = h[: -len(HOST_SUFFIX)]
            if prefix and "." not in prefix:
                routes = get_routes()
                if prefix in routes:
                    return prefix, routes[prefix], _strip_well_known_mcp_suffix(
                        path.split("?", 1)[0] or "/"
                    )
    # ---- Path routing ----
    clean = path.split("?", 1)[0]
    if clean.startswith("/"):
        clean = clean[1:]
    if not clean:
        return None, None, "/"
    parts = clean.split("/", 1)
    project = parts[0]
    rest = "/" + (parts[1] if len(parts) > 1 else "")
    routes = get_routes()
    route = routes.get(project)
    if route is not None:
        return project, route, rest if rest != "/" else "/mcp"
    # Resolve root OAuth and well-known discovery to a sole project.
    if _root_oauth_path("/" + clean):
        # First try inserted project paths such as .../oauth-authorization-server/novo.
        ins_proj, canonical = _split_discovery_insertion("/" + clean)
        if ins_proj and ins_proj in routes:
            return ins_proj, routes[ins_proj], canonical
        if canonical and canonical != "/" + clean and len(routes) == 1:
            only = next(iter(routes))
            return only, routes[only], canonical
        if len(routes) == 1:
            only = next(iter(routes))
            # Fallback after Claude discovery failure: POST /register → /oauth/register.
            target = "/oauth/register" if clean == "register" else "/" + clean
            return only, routes[only], target
        return None, None, "/" + clean  # Caller returns explicit guidance for ambiguity.
    return project, None, rest


class RouterHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write(f"[herdr-mcp-router] {self.address_string()} {fmt % args}\n")

    # ---- Request-body reading for Content-Length, chunked, and Expect ----
    def _read_body(self) -> bytes:
        te = self.headers.get("Transfer-Encoding", "").lower()
        if "chunked" in te:
            chunks = []
            while True:
                line = self.rfile.readline().strip()
                try:
                    size = int(line.split(b";", 1)[0], 16)
                except ValueError:
                    break
                if size == 0:
                    self.rfile.readline()  # Trailing CRLF; trailers are ignored.
                    break
                chunks.append(self.rfile.read(size))
                self.rfile.read(2)  # CRLF
            return b"".join(chunks)
        length = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(length) if length > 0 else b""

    def _drain_body(self) -> None:
        """HTTP/1.1 keep-alive desync guard (herdr-mcp P0).

        Any response path that does not otherwise consume the request body must
        drain rfile first. Residual bytes would be parsed as the next request line:
            code 400, message Bad request syntax ('{"jsonrpc":...}POST / HTTP/1.1')
        Clients surface this as Session terminated, network_error, or 502.
        Reply 100 before reading Expect: 100-continue bodies. Close the connection
        if reading fails because closing is safer than leaving it half-open.
        """
        if self.headers.get("Expect", "").lower() == "100-continue":
            try:
                self.send_response_only(100)
                self.end_headers()
            except OSError:
                self.close_connection = True
                return
        try:
            self._read_body()
        except (OSError, ValueError):
            self.close_connection = True

    def _write_chunked(self, data: bytes) -> None:
        if data:
            self.wfile.write(f"{len(data):x}\r\n".encode() + data + b"\r\n")

    def do_OPTIONS(self) -> None:
        if self.path.split("?", 1)[0] in {"/", "/healthz", "/projects"}:
            self._drain_body()
            self.send_response(204)
            self._cors()
            self.end_headers()
            return
        self._proxy()

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path in {"/", "/healthz"}:
            self._status_page()
            return
        if path == "/projects":
            self._projects_json()
            return
        self._proxy()

    def do_HEAD(self) -> None:
        if self.path.split("?", 1)[0] in {"/", "/healthz"}:
            self._drain_body()
            self.send_response(200)
            self._cors()
            self.end_headers()
            return
        self._proxy()

    def do_POST(self) -> None:
        self._proxy()

    def do_PUT(self) -> None:
        self._proxy()

    def do_DELETE(self) -> None:
        self._proxy()

    def do_PATCH(self) -> None:
        self._proxy()

    def _cors(self) -> None:
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.send_header("Access-Control-Expose-Headers", "*")

    def _status_page(self) -> None:
        self._drain_body()  # keep-alive guard: GET with a body must not poison the next request
        routes = get_routes()
        rows = []
        for name, r in sorted(routes.items()):
            port = r.get("port")
            ok = self._probe(port)
            rows.append(
                f"<tr><td><b>{name}</b></td><td>{port}</td>"
                f"<td>{'✅ up' if ok else '❌ down'}</td>"
                f"<td><code>/{name}/mcp</code></td></tr>"
            )
        body = (
            "<!doctype html><html><head><meta charset=utf-8>"
            "<title>herdr-mcp router</title>"
            "<style>body{font-family:system-ui;margin:2rem}"
            "table{border-collapse:collapse}td,th{border:1px solid #ddd;padding:6px 10px}"
            "code{background:#f4f4f4;padding:2px 4px}</style></head><body>"
            "<h1>herdr-mcp router</h1>"
            f"<p>listening on {HOST}:{PORT} · routes from <code>{ROUTES_FILE}</code></p>"
            "<table><tr><th>project</th><th>port</th><th>health</th><th>path</th></tr>"
            + ("".join(rows) if rows else "<tr><td colspan=4>(no projects)</td></tr>")
            + "</table></body></html>"
        ).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self._cors()
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _projects_json(self) -> None:
        self._drain_body()  # keep-alive guard (same as _status_page)
        routes = get_routes()
        projects = []
        for name, r in sorted(routes.items()):
            port = r.get("port", "")
            projects.append(
                {
                    "name": name,
                    "port": str(port),
                    "token": r.get("token", ""),
                    "url": f"http://127.0.0.1:{port}/mcp",
                    "public_path": f"/{name}/mcp",
                    "path": r.get("path", ""),
                }
            )
        body = json.dumps({"projects": projects}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self._cors()
        self.end_headers()
        self.wfile.write(body)

    def _probe(self, port: Any) -> bool:
        try:
            p = int(port)
        except (TypeError, ValueError):
            return False
        try:
            with socket.create_connection(("127.0.0.1", p), timeout=0.4):
                return True
        except OSError:
            return False

    def _send_error(self, status: int, msg: str) -> None:
        # keep-alive desync guard: 404/502 error paths never read the request
        # body (unknown project, upstream error) — drain it or the next
 # request on this connection parses as garbage (Bad request syntax).
        self._drain_body()
        body = msg.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self._cors()
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _proxy(self) -> None:
        raw_path = self.path
        path_only = raw_path.split("?", 1)[0]
        qs = raw_path.split("?", 1)[1] if "?" in raw_path else ""
        project, route, rest = resolve_route(path_only, self.headers.get("Host", ""))
        if route is None:
            if _root_oauth_path(path_only) and project is None and len(get_routes()) > 1:
                self._send_error(
                    404,
                    "herdr-mcp-router: root OAuth/.well-known discovery requires exactly one project. "
                    "Multiple projects on one hostname are ambiguous; use a fully prefixed URL: "
                    "https://herdr-mcp.<domain>/<project>/.well-known/oauth-authorization-server\n",
                )
            else:
                self._send_error(404, f"herdr-mcp-router: unknown project '{project}'\n")
            return

        port = int(route["port"])
        target_path = rest + (f"?{qs}" if qs else "")
        url = f"http://127.0.0.1:{port}{target_path}"

        # Reply 100 before reading an Expect: 100-continue body.
        if self.headers.get("Expect", "").lower() == "100-continue":
            self.send_response_only(100)
            self.end_headers()
        body = self._read_body()

        req = urllib.request.Request(url, data=body, method=self.command)
        for key, value in self.headers.items():
            lk = key.lower()
            if lk in HOP_BY_HOP or lk == "expect":
                continue
            req.add_header(key, value)
        req.add_header("X-Forwarded-Prefix", f"/{project}")
        req.add_header("X-Herdr-MCP-Project", project)

        try:
            with _OPENER.open(req, timeout=600) as resp:
                self.send_response(resp.status)
                upstream_chunked = False
                for key, value in resp.headers.items():
                    lk = key.lower()
                    if lk in RESPONSE_SKIP:
                        if lk == "transfer-encoding" and "chunked" in value.lower():
                            upstream_chunked = True
                        continue
                    self.send_header(key, value)
                self._cors()
                self.end_headers()
                if self.command == "HEAD":
                    return
                if upstream_chunked:
                    # Reframe chunked upstream streams so clients receive the terminating chunk.
                    while True:
                        chunk = resp.read(65536)
                        if not chunk:
                            break
                        self._write_chunked(chunk)
                        self.wfile.flush()  # Flush SSE and long streams immediately.
                    self.wfile.write(b"0\r\n\r\n")
                else:
                    while True:
                        if resp.length is None and not resp.chunked:
                            # For close-delimited streams, read available data without blocking for a full buffer.
                            chunk = resp.fp.read1(65536)
                        else:
                            chunk = resp.read(65536)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        if len(chunk) < 65536 or self.command == "GET":
                            # Flush each chunk for SSE and unbounded GET streams.
                            self.wfile.flush()
        except urllib.error.HTTPError as exc:
            self.send_response(exc.code)
            upstream_chunked = False
            for key, value in exc.headers.items():
                lk = key.lower()
                if lk in RESPONSE_SKIP:
                    if lk == "transfer-encoding" and "chunked" in value.lower():
                        upstream_chunked = True
                    continue
                self.send_header(key, value)
            self._cors()
            self.end_headers()
            if self.command != "HEAD":
                data = exc.read()
                if data:
                    if upstream_chunked:
                        self._write_chunked(data)
                    else:
                        self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass  # The client disconnected; no response can be written.
        except Exception as exc:
            try:
                self._send_error(502, f"herdr-mcp-router: upstream error: {exc}\n")
            except (BrokenPipeError, ConnectionResetError):
                pass


def main() -> int:
    os.makedirs(STATE_DIR, exist_ok=True)
    routes = get_routes()
    print(
        f"herdr-mcp-router listening on http://{HOST}:{PORT} "
        f"({len(routes)} routes, state={STATE_DIR})",
        file=sys.stderr,
        flush=True,
    )
    httpd = ThreadingHTTPServer((HOST, PORT), RouterHandler)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nherdr-mcp-router stopped", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
