# --- Node.js build / cache ---
node_modules/
dist/
site-dist/
*.tsbuildinfo

# --- Rust build / cache ---
target/

# --- Test / coverage / tooling artifacts ---
coverage/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
.tox/
.mypy_cache/
.ruff_cache/

# --- Logs / temp ---
*.log
*.tmp
tmp/
*.swp
*~
.DS_Store

# --- Secrets / local auth (never commit real values; keep .env.example) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.p8

# --- OAuth / session / local runtime state ---
.pi/

# --- Editor / OS ---
.vscode/
.idea/
*.sublime-*
Thumbs.db
Desktop.ini

# --- Herdr / PI / OMP local artifacts ---
.herdr/
.omp/
.hermes/
edge/cloudflare/.wrangler/

# --- Process / scratch notes (not for publishing) ---
# Keep durable guides under docs/*.md tracked.
# docs/_wip is for active design/planning Markdown only. Keep local evidence/recon dumps ignored.
docs/_wip/*
!docs/_wip/*.md
!docs/_wip/en/
!docs/_wip/zh-CN/
TODO.md
OPTIMIZATION.md
