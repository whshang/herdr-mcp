{
  "name": "herdr-mcp",
  "version": "0.3.30",
  "description": "Lean MCP HTTP gateway: ChatGPT Connector / Cursor drive local Herdr plus gated fs/git/exec; Chrome extension wakes the web chat",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "herdr-mcp": "dist/server.js",
    "herdr-cloudflare-token": "bin/herdr-cloudflare-token",
    "herdr-cloudflare-dns-token": "bin/herdr-cloudflare-dns-token",
    "herdr-cloudflare-domain": "bin/herdr-cloudflare-domain",
    "herdr-custom-domain-cutover": "bin/herdr-custom-domain-cutover",
    "herdr-runtime-generation": "bin/herdr-runtime-generation",
    "herdr-self-update": "bin/herdr-self-update"
  },
  "scripts": {
    "build": "tsc",
    "build:site": "node scripts/build-site.mjs",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:edge": "npm run build && tsc -p edge/cloudflare/tsconfig.json && node --test \"edge/cloudflare/tests/*.test.mjs\" tests/relay-edge-compat.integration.mjs",
    "cloudflare:token": "bin/herdr-cloudflare-token",
    "cloudflare:dns-token": "bin/herdr-cloudflare-dns-token",
    "cloudflare:domain": "bin/herdr-cloudflare-domain",
    "cloudflare:cutover": "bin/herdr-custom-domain-cutover",
    "runtime:generation": "bin/herdr-runtime-generation",
    "self:update": "bin/herdr-self-update"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "marked": "^18.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
