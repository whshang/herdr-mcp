{
  "name": "herdr-mcp",
  "version": "1.1.1",
  "description": "Herdr MCP bridge for Web AI and local agents: gated workstation control, Edge routing, browser continuity, and handoff",
  "type": "module",
  "bin": {
    "herdr-cloudflare-token": "bin/herdr-cloudflare-token",
    "herdr-cloudflare-dns-token": "bin/herdr-cloudflare-dns-token",
    "herdr-cloudflare-domain": "bin/herdr-cloudflare-domain",
    "herdr-custom-domain-cutover": "bin/herdr-custom-domain-cutover",
    "herdr-runtime-generation": "bin/herdr-runtime-generation",
    "herdr-self-update": "bin/herdr-self-update",
    "herdr-extension-host": "bin/herdr-extension-host"
  },
  "scripts": {
    "build": "tsc",
    "build:site": "node scripts/build-site.mjs",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test \"tests/*.test.mjs\" && node tests/manual/background_bind_test.mjs",
    "test:edge": "npm run test:edge:built",
    "test:edge:built": "tsc -p edge/cloudflare/tsconfig.json && node --test \"edge/cloudflare/tests/*.test.mjs\" tests/public-contract-identity.integration.mjs",
    "cloudflare:token": "bin/herdr-cloudflare-token",
    "cloudflare:dns-token": "bin/herdr-cloudflare-dns-token",
    "cloudflare:domain": "bin/herdr-cloudflare-domain",
    "cloudflare:cutover": "bin/herdr-custom-domain-cutover",
    "runtime:generation": "bin/herdr-runtime-generation",
    "self:update": "bin/herdr-self-update",
    "relay:manifest:sign": "node scripts/sign-relay-manifest.mjs",
    "relay:supabase:bundle": "node scripts/build-supabase-relay.mjs",
    "relay:supabase:check": "node scripts/build-supabase-relay.mjs --check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^22.0.0",
    "marked": "^18.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
